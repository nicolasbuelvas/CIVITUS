; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by text.

config_version=5

[application]

config/name="AstroStranded: Paper Odyssey"
config/description="2.5D Procedural Space Survival game inspired by Paper Mario, Blocktales and Waste of Space."
run/main_scene="res://scenes/screens/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.04, 0.04, 0.08, 1)

[autoload]

GameManager="*res://scripts/autoloads/game_manager.gd"
RevenueCatManager="*res://scripts/autoloads/revenuecat_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

